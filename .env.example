# Tevion environment example. Copy to .env for local overrides.
# Never commit real credentials.

# Local PostgreSQL (docker-compose.yml)
POSTGRES_USER=tevion
POSTGRES_PASSWORD=tevion_dev
POSTGRES_DB=tevion

# API database URL (used by db.py / Alembic)
TEVION_DB_URL=postgresql+psycopg://tevion:tevion_dev@localhost:5432/tevion

# Tests use a dedicated database
TEVION_TEST_DB_URL=postgresql+psycopg://tevion:tevion_dev@localhost:5432/tevion_test

# --- CORS ---
# Local/dev defaults allow localhost and 127.0.0.1 ports 3000, 5173, and 8000.
# Production should set an explicit comma-separated allowlist; blank is safest.
TEVION_ENVIRONMENT=local
# TEVION_CORS_ALLOWED_ORIGINS=https://app.example.com
# TEVION_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# TEVION_CORS_ALLOWED_HEADERS=Authorization,Content-Type
# Bearer tokens use the Authorization header; cookies are not enabled.
# Initial bootstrap only; after first admin login, manage super admins in /#admin.
# TEVION_ADMIN_SUBJECTS=demo_user

# --- Optional project visual-memory summarizer (server-side only) ---
# The key is never sent to apps/web and is never committed.
# LLM_MEMORY_ENABLED=false
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_SECONDS=8

# --- Remote image object storage (optional; server-side only) ---
# Never put the API key in apps/web or commit its real value.
# TEVION_STORAGE_API_KEY=

# Optional custom async image API. The key stays on the API server; never put
# it in the frontend. Protocol: POST /images/generations -> task_id, then
# GET /tasks/{task_id} -> status/result_urls. Image-to-image additionally uses
# POST /files/upload when a reference image is selected.
# IMAGE_PROVIDER=custom
# CUSTOM_IMAGE_BASE_URL=https://your-image-api.example.com/v1
# CUSTOM_IMAGE_API_KEY=
# CUSTOM_IMAGE_MODEL=gpt-image-2
# CUSTOM_IMAGE_TIMEOUT_SECONDS=300
# CUSTOM_IMAGE_POLL_INTERVAL_SECONDS=3
# TEVION_STORAGE_UPLOAD_URL=https://ysqvr.com/api/storage/upload
# TEVION_STORAGE_PRESIGN_URL=https://ysqvr.com/api/storage/presign
# TEVION_STORAGE_FOLDER=images

# --- Authentication (ADR-007) ---
# Dev mode: self-signed HS256 tokens (local/demo only, >=32 chars)
TEVION_AUTH_DEV_SECRET=change-me-to-a-long-random-string
# Production mode (set instead of dev secret): external OIDC provider
# TEVION_OIDC_ISSUER=https://your-provider.example.com
# TEVION_OIDC_JWKS_URL=https://your-provider.example.com/.well-known/jwks.json
# TEVION_AUTH_AUDIENCE=tevion-api
