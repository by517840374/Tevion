# Tevion environment example. Copy to .env for local overrides.
# Never commit real credentials.

# Local PostgreSQL (docker-compose.yml)
POSTGRES_USER=tevion
POSTGRES_PASSWORD=tevion_dev
POSTGRES_DB=tevion

# API database URL (used by db.py / Alembic)
TEVION_DB_URL=postgresql+psycopg://tevion:tevion_dev@localhost:5432/tevion

# Tests use a dedicated database
TEVION_TEST_DB_URL=postgresql+psycopg://tevion:tevion_dev@localhost:5432/tevion_test

# --- Authentication (ADR-007) ---
# Dev mode: self-signed HS256 tokens (local/demo only, >=32 chars)
TEVION_AUTH_DEV_SECRET=change-me-to-a-long-random-string
# Production mode (set instead of dev secret): external OIDC provider
# TEVION_OIDC_ISSUER=https://your-provider.example.com
# TEVION_OIDC_JWKS_URL=https://your-provider.example.com/.well-known/jwks.json
# TEVION_AUTH_AUDIENCE=tevion-api
